# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,yourdomain.com

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Email Configuration (Django)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMS Gateway (BulkSMS or similar)
SMS_GATEWAY_USER=your-sms-gateway-username
SMS_GATEWAY_KEY=your-sms-gateway-api-key
SMS_GATEWAY_SENDER_ID=YOUR_SENDER_ID
SMS_GATEWAY_URL=http://sms.bulkssms.com/submitsms.jsp

# API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# AWS/Cloud Storage (if using)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name

# GitHub Credentials (if needed)
GITHUB_TOKEN=your-github-token
GITHUB_USERNAME=your-username

# LinkedIn API (if needed)
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase (if using)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_DATABASE_URL=your-firebase-database-url

# Security
CSRF_TRUSTED_ORIGINS=localhost:3000,yourdomain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# Timezone
TIME_ZONE=UTC

# Language
LANGUAGE_CODE=en-us
